# Paycrest MCP server — copy to `.env` and adjust (see README).
# Values here are loaded when the binary starts if `godotenv` finds a `.env`
# in the current working directory (e.g. run from this `mcp/` folder).

# Aggregator base URL (no trailing slash). Used for all HTTP calls.
PAYCREST_BASE_URL=http://127.0.0.1:8080

# Do not put PAYCREST_API_KEY here for integrations — each user sets their own
# sender API key in the MCP host config (e.g. Cursor `mcp.json` → `env`).
# Required only for: paycrest_create_order, paycrest_list_sender_orders, paycrest_get_sender_order.

# Optional: outbound HTTP client timeout (Go duration, e.g. 30s, 2m)
# PAYCREST_HTTP_TIMEOUT=60s

# Optional: max response body size in bytes (default 10485760 = 10 MiB)
# PAYCREST_MAX_RESPONSE_BYTES=10485760
